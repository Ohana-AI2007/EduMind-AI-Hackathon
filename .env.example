# --- OpenAI (required for AI features; health/progress/document listing work without it) ---
OPENAI_API_KEY= your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: vision model for image descriptions (defaults to OPENAI_MODEL; must support image input)
OPENAI_VISION_MODEL=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Optional: leave empty for the model default (some models reject custom temperatures)
OPENAI_TEMPERATURE=
OPENAI_TIMEOUT_SECONDS=60

# --- Storage ---
DATABASE_URL=sqlite:///./data/edumind.db
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
MAX_REQUEST_BODY_KB=1024

# --- Server ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
DEFAULT_USER_ID=demo-user

# --- Chunking / retrieval ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MIN_RELEVANCE_SCORE=0.25

# --- Multimodal ---
ENABLE_IMAGE_DESCRIPTIONS=false
MAX_IMAGES_PER_DOCUMENT=10
ENABLE_OCR=true
VIDEO_SEGMENT_SECONDS=600

# --- Quiz ---
QUIZ_VERIFY_WITH_LLM=true
HISTORY_TURNS=6